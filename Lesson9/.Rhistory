sample.variances[i] = var(x)
lower.limits[i] = sample.means[i] - t.alpha.half * sqrt(sample.variances[i]/n)
upper.limits[i] = sample.means[i] + t.alpha.half * sqrt(sample.variances[i]/n)
}
