cbind(LL, x.bar, UL)
# setting the seed
set.seed(123)
# starting variables
mu = 10
sigma2 = 3
n = 10
# some checks
qnorm(0.95)
qt(0.95, df=10)
qt(0.95, df=500)
# creating our x
x = rnorm(n, mean=mu, sd=sqrt(sigma2))
# our significance level for the tests
alpha = 0.05
# creating variables that will be useful in our next calculations
t.alpha.half = qt(1-alpha/2, df=n-1)
x.bar=mean(x)
s2.tilde = var(x)
# confidence interval
LL = x.bar - t.alpha.half*sqrt(s2.tilde/n)
UL = x.bar + t.alpha.half*sqrt(s2.tilde/n)
cbind(LL, x.bar, UL)
cbind(LL, x.bar, UL)
typeof(cbind(LL, x.bar, UL))
class(cbind(LL, x.bar, UL))
sample.means = sample.variances = lower.limits = upper.limits = rep(NA, n.draws)
# Simulation Study : sampling distr of the CI
# P(LL<theta<UL)=1-alpha, 1-alpha out of 1 intervals will have theta inside
# either the P is 0 or 1
n.draws = 100
sample.means = sample.variances = lower.limits = upper.limits = rep(NA, n.draws)
# setting the seed
set.seed(123)
# starting variables
mu = 10
sigma2 = 3
n = 10
# some checks
qnorm(0.95)
qt(0.95, df=10)
qt(0.95, df=500)
# creating our x
x = rnorm(n, mean=mu, sd=sqrt(sigma2))
# our significance level for the tests
alpha = 0.05
# creating variables that will be useful in our next calculations
t.alpha.half = qt(1-alpha/2, df=n-1)
x.bar=mean(x)
s2.tilde = var(x)
# confidence interval
LL = x.bar - t.alpha.half*sqrt(s2.tilde/n)
UL = x.bar + t.alpha.half*sqrt(s2.tilde/n)
# full visualization of the CI
cbind(LL, x.bar, UL) # our true mean is inside
# Simulation Study : sampling distr of the CI
# P(LL<theta<UL)=1-alpha, 1-alpha out of 1 intervals will have theta inside
# either the P is 0 or 1
n.draws = 100
# empty boxes
sample.means = sample.variances = lower.limits = upper.limits = rep(NA, n.draws)
for (i in n.draws) {
x = rnorm(n,mu,sqrt(sigma2))
sample.means[i] = mean(x)
sample.variances[i] = var(x)
lower.limits[i] = sample.means[i] - t.alpha.half * sqrt(sample.variances[i])
upper.limits[i] = sample.means[i] + t.alpha.half * sqrt(sample.variances[i])
}
cover = ifelse(lower.limits < mu & upper.limits > mu, 1, 0)
mean(cover)
