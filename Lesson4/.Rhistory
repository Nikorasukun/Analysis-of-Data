# set-up
lambdat = 35
sims = 4000 # montecarlo repetition of the same experiment, try different values
m = c(15,50,800) # different sample sizes
E.of.X = V.of.X = lmbdat # expected value and variance of our rv, so lambda true
# empty box for the results
Z = matrix(NA, nrow=sims, ncol=length(m))
set.seed(7)
for(j in 1:length(m)) { # loop over length of m (sample size)
for(i in 1:sims) { # loop over sims
samp = rpois(n=m[j], lambda = lambdat) # our sample
sample.mean = mean(samp) # raw mean
Z[i,j] = (sample.mean-E.of.X)/sqrt(V.of.X/m[j]) # standardized mean
} # closure of i-th for
} # closure of j-th for
View(Z)
hist(Z[,1], col="blue")
hist(Z[,1], col="blue", main="nice histogram")
hist(Z[,1], col="blue", main="nice histogram", freq = FALSE)
hist(Z[,1], col="blue", main="nice histogram", freq = F, breaks = c(-5,-1,0,2,5))
hist(Z[,1], col="blue", main="nice histogram", freq = F, breaks = seq(-5,5,by=0.2))
hist(Z[,1], col="blue", main="nice histogram", freq = F, breaks = seq(-5,5,by=0.1))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = seq(-5,5,by=0.1))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = seq(-5,5,by=0.1))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = c(-5,-1,0,2,5))
hist(Z[,1], col="blue", main="nice histogram", freq = F, breaks = c(-5,-1,0,2,5))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = c(-5,-1,0,2,5))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = seq(-5,5,by=0.01))
hist(Z[,3], col="blue", main="nice histogram", freq = T, breaks = seq(-5,5,by=0.01))
hist(Z[,1], col="blue", main="nice histogram", freq = T, breaks = seq(-5,5,by=0.1))
hist(Z[,1], col="blue")
hist(Z[,1], col="blue", breaks=10)
hist(Z[,1], col="blue", breaks=30)
hist(Z[,1], col="blue", breaks=300)
hist(Z[,1], col="blue", breaks=30)
hist(Z[,2], col="green")
hist(Z[,1], col="blue")
hist(Z[,2], col="green", density = 80, add=T)
hist(Z[,3], col="orange", density = 20, add=T)
windows()
hist(Z[,1], col="blue")
hist(Z[,2], col="green", density = 80, add=T)
hist(Z[,3], col="orange", density = 20, add=T)
par(mfrow=c(3,1))
for (j in 1:length(m)) {
hist(Z[,j],
xlim=c(-4,4),
freq=F,
ylim=c(0,0.5),
breaks=40,
ylab="Probabilty",
xlab = "",
main = paste("Sample size =", m[j])
)
}
par(mfrow=c(3,1))
