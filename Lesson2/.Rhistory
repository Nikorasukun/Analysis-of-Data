# number of trials
n = 100
# prob of success
p = 0.5
# support of x
x = 0:n
# the pmf
px = dbinom(x,size=n,prob=p)
# the CDF
Fx = pbinom(x,n,p)
# quantile function
qbinom(0.5, n, p)
# normal RV
dnorm(0)
1/sqrt(2*pi)
dnorm(1) == dnorm(-1)
pnorm(0)
pnorm(1.645)
qnorm(0.975)
qnorm(0.95)
# let's go back to the binomial rv
# random generation from a distribution
set.seed(4)
n.draws = 20000
sample.bin = rbinom(n.draws, n,p)
# compare theoretical vs simulated
n*p
mean(sample.bin)
n*p*(1-p)
var(sample.bin) # divided by n-1
count.50 = mean(sample.bin == 50)
dbinom(50,n,p)
# now the whole pmf
px.sim = rep(NA,n+1)
for(i in 1:(n+1)) {
count = sample.bin == x[i]
px.sim[i] = sum(count)/n.draws
} # in one line: px.sim[i] = mean(sample.bin==x[i])
# is this a good approx?
sum(abs(px-px.sim)) # 0.02678
# cumsum
cumsum(1:6)
Fx.sim = cumsum(px.sim)
sum(abs(Fx-Fx.sim))
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim)
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim, col="red")
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim, col="red", pch=3)
windows() #for mac quartz()
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim, col="red", pch=3)
plot(
x,Fx,
main="Fx",ylab=""
)
points(x,Fx.sim,col="red",pch=3)
legend(60, 0.7, legend = c("True", "Sim"),
col = c("black", "red"), pch= c(1,3))
windows() #for mac quartz()
par(mfrow=c(1,2)) # 1 row, 2 columns
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim, col="red", pch=3)
plot(
x,Fx,
main="Fx",ylab=""
)
points(x,Fx.sim,col="red",pch=3)
legend(60, 0.7, legend = c("True", "Sim"),
col = c("black", "red"), pch= c(1,3))
# comparison with a normal distribution
par(mfrow=c(1,1))
plot(
x, px, type="h", col="blue"
)
plot(
x, px, type="h", col="blue"
)
lines(x, px.sim, type="h", col="red", lwd=2)
curve(
dnorm(x, mean=n*p ,sd=sqrt(n*p*(1-p)), from=0, to=100, col="green", add=TRUE)
)
dnorm(x, mean=n*p ,sd=sqrt(n*p*(1-p)), from=0, to=100, col="green", add=TRUE
curve(
curve(
dnorm(x, mean=n*p ,sd=sqrt(n*p*(1-p))), from=0, to=100, col="green", add=TRUE
)
# number of trials
n = 100
# prob of success
p = 0.01
# support of x
x = 0:n
# the pmf
px = dbinom(x,size=n,prob=p)
# the CDF
Fx = pbinom(x,n,p)
# quantile function
qbinom(0.5, n, p)
# normal RV
dnorm(0)
1/sqrt(2*pi)
dnorm(1) == dnorm(-1)
pnorm(0)
pnorm(1.645)
qnorm(0.975)
qnorm(0.95)
# let's go back to the binomial rv
# random generation from a distribution
set.seed(4)
n.draws = 20000
sample.bin = rbinom(n.draws, n,p)
# compare theoretical vs simulated
n*p
mean(sample.bin)
n*p*(1-p)
var(sample.bin) # divided by n-1
count.50 = mean(sample.bin == 50)
dbinom(50,n,p)
# now the whole pmf
px.sim = rep(NA,n+1)
for(i in 1:(n+1)) {
count = sample.bin == x[i]
px.sim[i] = sum(count)/n.draws
} # in one line: px.sim[i] = mean(sample.bin==x[i])
# is this a good approx?
sum(abs(px-px.sim)) # 0.02678
# cumsum
cumsum(1:6)
Fx.sim = cumsum(px.sim)
sum(abs(Fx-Fx.sim)) # 0.04197
# let's check it graphically
windows() #for mac quartz()
par(mfrow=c(1,2)) # 1 row, 2 columns
plot(
x, px,
main = "px", ylab=""
)
points(x,px.sim, col="red", pch=3)
plot(
x,Fx,
main="Fx",ylab=""
)
points(x,Fx.sim,col="red",pch=3)
legend(60, 0.7, legend = c("True", "Sim"),
col = c("black", "red"), pch= c(1,3))
# comparison with a normal distribution
par(mfrow=c(1,1))
plot(
x, px, type="h", col="blue"
)
lines(x, px.sim, type="h", col="red", lwd=2)
curve(
dnorm(x, mean=n*p ,sd=sqrt(n*p*(1-p))),
from=0,
to=100,
col="green",
add=TRUE
)
